VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_DATABASE_URL=https://your-database-url

# Admin SDK seed setup; keep service-account JSON outside the repository.
FIREBASE_SERVICE_ACCOUNT_PATH=C:/secure/firebase-service-account.json
FIREBASE_ADMIN_UID=your-auth-user-uid
